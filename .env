# Leave empty in local dev to use Vite proxy (which proxies to https://localhost:7009 with SSL bypass)
# In production, set to your deployed public API URL
VITE_FACE_API_URL=https://facedetection-rawkode.runasp.net

# RSVP Storage API URL
# Leave empty in local dev to save to src/data/rsvps.json and localStorage.
# In production, set to your deployed Google Apps Script Web App URL (starts with https://script.google.com/macros/s/.../exec)
VITE_RSVP_API_URL=

# Host Admin RSVP Dashboard PIN (default: 2027)
VITE_ADMIN_PIN=2027
